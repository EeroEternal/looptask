{
  "project": {
    "name": "looptask",
    "repository": "https://github.com/EeroEternal/looptask",
    "defaultBranch": "main",
    "techStack": ["rust", "axum", "tokio", "celld", "durable-objects"],
    "docs": ["README.md"],
    "sourcePaths": ["src", "tests", "celld/src"],
    "celld": {
      "appDir": "celld",
      "bucket": "looptask",
      "publicUrl": "http://127.0.0.1:9876",
      "internalUrl": null,
      "durableObjectClass": "AgentCell",
      "artifactBucketPrefix": "agents"
    },
    "externalDataSources": [
      {
        "name": "example-registry",
        "url": "https://example.com/registry.json",
        "cachePath": "data/example-registry.json",
        "schemaPath": "schemas/example-registry.schema.json"
      }
    ],
    "loops": [
      {
        "name": "docs-sync",
        "kind": "docs_sync",
        "goal": "Keep README and project documentation aligned with source changes.",
        "mode": "safe-pr",
        "trigger": {
          "type": "group",
          "listeners": [
            {
              "type": "github",
              "events": ["pr-pushed", "ci-failed"],
              "paths": ["src/**", "docs/**", "README.md"],
              "branches": ["main"]
            },
            {
              "type": "cron",
              "schedule": "0 9 * * 1-5",
              "timezone": "Asia/Shanghai",
              "quietHours": { "start": "22:00", "end": "08:00" }
            }
          ]
        },
        "lifetime": { "kind": "standing" },
        "agent": {
          "cellIdTemplate": "{project}/{loop}/{agent}",
          "sandboxRequired": false,
          "allowedTools": ["read-repo", "write-docs"],
          "humanGate": false
        },
        "verifiers": [
          {
            "name": "rust-tests",
            "command": ["cargo", "test", "--workspace"],
            "timeoutSeconds": 120
          }
        ],
        "state": {
          "hotSqliteScope": "agent-cell",
          "artifactUriPrefix": "r2://looptask/agents/{agent}/artifacts/",
          "hotMessageLimit": 50
        },
        "stopRules": {
          "maxSteps": 8,
          "maxConsecutiveFailures": 3,
          "largeFileLines": 500
        },
        "escalationRules": [
          "Escalate when documentation changes require product or architecture decisions."
        ]
      },
      {
        "name": "ci-red-watch",
        "kind": "ci_watch",
        "goal": "Watch main CI failures, report evidence, and disarm after green or a short run budget.",
        "mode": "report-only",
        "trigger": {
          "type": "github",
          "events": ["ci-failed"],
          "branches": ["main"],
          "ciBranch": "main"
        },
        "lifetime": {
          "kind": "until",
          "until": {
            "anyOf": [
              { "type": "ci-passed" },
              { "type": "maxRuns", "count": 5 },
              { "type": "human-disable" }
            ]
          },
          "onExpire": "pause-and-archive"
        },
        "agent": {
          "cellIdTemplate": "{project}/{loop}/{agent}",
          "sandboxRequired": true,
          "allowedTools": ["read-repo", "gh"],
          "humanGate": false
        },
        "verifiers": [],
        "stopRules": {
          "maxSteps": 6,
          "maxConsecutiveFailures": 2,
          "largeFileLines": 500
        },
        "escalationRules": [
          "Escalate when the failure is outside the loop allow-list or needs product judgment."
        ]
      },
      {
        "name": "external-data-sync",
        "kind": "external_data_sync",
        "goal": "Check configured external data sources before generated cache updates.",
        "mode": "safe-pr",
        "trigger": {
          "type": "manual"
        },
        "lifetime": { "kind": "standing" },
        "agent": {
          "cellIdTemplate": "{project}/{loop}/{agent}",
          "sandboxRequired": true,
          "allowedTools": ["fetch", "schema-validate", "write-cache"],
          "humanGate": false
        },
        "verifiers": [],
        "escalationRules": [
          "Escalate when schema validation is missing or fetched data is empty."
        ]
      },
      {
        "name": "architecture-scan",
        "kind": "architecture_scan",
        "goal": "Find coupling hotspots and suggest decoupling work without automatic refactors.",
        "mode": "report-only",
        "trigger": {
          "type": "cron",
          "schedule": "0 9 1 * *",
          "timezone": "Asia/Shanghai"
        },
        "lifetime": { "kind": "standing" },
        "agent": {
          "cellIdTemplate": "{project}/{loop}/{agent}",
          "sandboxRequired": true,
          "allowedTools": ["read-repo", "static-analysis"],
          "humanGate": true
        },
        "verifiers": [],
        "stopRules": {
          "maxSteps": 12,
          "maxConsecutiveFailures": 2,
          "largeFileLines": 500
        },
        "escalationRules": [
          "Escalate before changing module boundaries or public APIs."
        ]
      }
    ]
  }
}