{
  "project": {
    "name": "looptask",
    "repository": "https://github.com/EeroEternal/looptask",
    "defaultBranch": "main",
    "techStack": ["python"],
    "docs": ["README.md"],
    "sourcePaths": ["src", "tests"],
    "commands": {
      "test": ["python", "-m", "unittest", "discover", "-s", "tests"]
    },
    "externalDataSources": [
      {
        "name": "example-registry",
        "url": "https://example.com/registry.json",
        "cachePath": "data/example-registry.json",
        "schemaPath": "schemas/example-registry.schema.json"
      }
    ]
  },
  "loops": [
    {
      "name": "docs-sync",
      "type": "docs_sync",
      "goal": "Keep README and project documentation aligned with source changes.",
      "mode": "safe-pr",
      "trigger": {
        "type": "cron",
        "schedule": "0 9 * * 1"
      },
      "verifiers": [
        {
          "name": "unit-tests",
          "command": ["python", "-m", "unittest", "discover", "-s", "tests"],
          "timeoutSeconds": 120
        }
      ],
      "state": {
        "path": ".looptask/state/docs-sync.json"
      },
      "stopRules": {
        "maxChangedFiles": 10
      },
      "escalationRules": [
        "Escalate when documentation changes require product or architecture decisions."
      ]
    },
    {
      "name": "external-data-sync",
      "type": "external_data_sync",
      "goal": "Check configured external data sources before generated cache updates.",
      "mode": "safe-pr",
      "trigger": {
        "type": "manual"
      },
      "verifiers": [],
      "state": {
        "path": ".looptask/state/external-data-sync.json"
      },
      "stopRules": {
        "requireSchemaBeforeOverwrite": true
      },
      "escalationRules": [
        "Escalate when schema validation is missing or fetched data is empty."
      ]
    },
    {
      "name": "architecture-scan",
      "type": "architecture_scan",
      "goal": "Find coupling hotspots and suggest decoupling work without automatic refactors.",
      "mode": "report-only",
      "trigger": {
        "type": "cron",
        "schedule": "0 9 1 * *"
      },
      "verifiers": [],
      "state": {
        "path": ".looptask/state/architecture-scan.json"
      },
      "stopRules": {
        "largeFileLines": 500
      },
      "escalationRules": [
        "Escalate before changing module boundaries or public APIs."
      ]
    }
  ]
}
